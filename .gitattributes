* text=auto eol=lf
*.png binary
*.wav binary
*.sqlite3 binary

# cmd.exe mishandles labels and goto in a batch file with LF endings, so the
# Windows launchers must always be checked out with CRLF. This rule has to come
# AFTER the catch-all above: in .gitattributes the last matching line wins, and
# the previous ordering let "* eol=lf" silently override it.
*.bat text eol=crlf
