# Copy to .env and fill in. Never commit .env.

# --- Which transcriber ---
#   deepgram     = cloud, fast, about $0.0077/min
#   speechmatics = cloud, Cantonese (yue) with live diarization
#   local        = offline on this machine, free, no diarization
# It can also be chosen per meeting in the form.
STT_PROVIDER=deepgram

# --- Deepgram (required when STT_PROVIDER=deepgram) ---
DEEPGRAM_API_KEY=

# Cantonese. Deepgram language code for Cantonese Traditional is zh-HK.
DEEPGRAM_LANGUAGE=zh-HK
# nova-3 is tried first; if the model/language pair is rejected the app
# automatically falls back to the next entry in this list.
DEEPGRAM_MODELS=nova-3,nova-2

# --- Speechmatics (required when STT_PROVIDER=speechmatics) ---
SPEECHMATICS_API_KEY=
# eu2 is the default region; use us1/au1 if you are billed there.
SPEECHMATICS_URL=wss://eu2.rt.speechmatics.com/v2
# standard = cheaper and faster, enhanced = more accurate
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_USD_PER_MINUTE=0.0173

# --- Local model (required when STT_PROVIDER=local) ---
# One-time setup:
#   pip install -r requirements-local.txt
#   python scripts/download_models.py --punct
# Audio never leaves this machine and transcription is free. There is no
# diarization, so every line arrives unattributed -- click a line to name it.
SHERPA_MODEL_DIR=
SHERPA_PUNCTUATION_DIR=
# More threads decode faster; 2 already runs about 11x faster than real time.
SHERPA_NUM_THREADS=2
# The transcriber emits no punctuation of its own.
SHERPA_PUNCTUATE=1
# It also writes simplified characters even for Cantonese speech; this maps them
# to Hong Kong traditional.
SHERPA_TO_TRADITIONAL=1

# --- LLM copilot (required) ---
OPENROUTER_API_KEY=
# Fast + very cheap advisor model. Alternatives:
#   qwen/qwen3.6-plus, deepseek/deepseek-chat, qwen/qwen-plus
OPENROUTER_MODEL=deepseek/deepseek-v3.2
# Optional: a stronger model for notes/summary. Defaults to OPENROUTER_MODEL.
OPENROUTER_NOTES_MODEL=

# --- Web search for answering questions raised in the meeting (optional) ---
# Without this, the copilot answers from model knowledge only and says so.
TAVILY_API_KEY=

# --- Behaviour tuning ---
# Language the copilot writes its advice, notes and spoken turns in.
COPILOT_OUTPUT_LANGUAGE=Traditional Chinese (Hong Kong), keeping English technical terms in English
# Minimum seconds between think cycles. One cycle produces both the private
# coaching and the AI attendee's turn, so this is the main cost dial.
THINK_MIN_INTERVAL=15
# Minimum new characters of transcript before it thinks again.
THINK_MIN_NEW_CHARS=120
# Shorter floor when someone in the room just asked a question, so the attendee
# can answer while the room is still waiting. Never set this to 0.
THINK_URGENT_INTERVAL=5
# Seconds between note-taking passes.
NOTES_INTERVAL=90

# --- The AI attendee (the bottom-left panel) ---
# It behaves like a participant: raises questions it thinks need asking and
# answers questions the room has left hanging.
#   quiet  = only answers direct questions
#   normal = also raises its own when something matters
#   active = contributes more freely
ATTENDEE_MODE=normal
ATTENDEE_ENABLED=1

# --- Speaker identification ---
# Diarisation separates voices; these control how often the copilot tries to
# work out which voice belongs to which person on your attendee list. It only
# ever suggests -- you accept with one click.
SPEAKER_GUESS_INTERVAL=120
SPEAKER_GUESS_MIN_SEGMENTS=8

# Boost the glossary and attendee names in the transcriber. Deepgram rejects
# this on some model/language pairs; the app then retries without it.
DEEPGRAM_KEYTERMS=1

# --- Cost readout (used only for the on-screen estimate) ---
DEEPGRAM_USD_PER_MINUTE=0.0077

# --- Server ---
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-me
# Save raw meeting audio to ./data/audio for later tuning. Off by default.
SAVE_AUDIO=0
